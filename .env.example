# Access controls (Firebase login + credits). Copy to .env.local and fill in.
# Values for Vercel go in the project's environment settings.

# --- server ---
FIREBASE_PROJECT_ID=machax-b8796
# fallback per-message cost in micro-dollars until real averages exist
# (mean of 9 metered messages from scripts/measure-message-cost.ts, 2026-10-28)
DEFAULT_MESSAGE_COST_MICROS=28179
# Razorpay dashboard > Account & Settings > API keys (rzp_test_... in test mode)
RAZORPAY_KEY_ID=
# secret half of that API key; also signs checkout success callbacks
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks: secret for <site>/api/pay/razorpay/webhook
# (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=
# any long random string. RevenueCat dashboard > Integrations > Webhooks for
# <site>/api/pay/revenuecat/webhook sends its "Authorization header" field exactly
# as typed: enter it there as "Bearer <this value>", not the bare value
REVENUECAT_WEBHOOK_SECRET=

# --- client (inlined at build time) ---
# comma-separated Firebase uids allowed into /admin; empty means nobody
NEXT_PUBLIC_ADMIN_UIDS=
# Firebase console > project settings > your apps > web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=machax-b8796.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=machax-b8796
NEXT_PUBLIC_FIREBASE_APP_ID=
# same value as RAZORPAY_KEY_ID; fallback for checkout if the order response lacks it
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RevenueCat dashboard > project > API keys > Google Play public key (goog_...);
# empty turns Play purchases off in the Android app
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
